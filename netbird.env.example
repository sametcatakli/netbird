# NetBird installer settings. Copy to netbird.env to skip the interactive prompts.
# Environment variables take precedence over this file.

# Public domain name of the service. Any name works.
NETBIRD_DOMAIN="vpn.example.com"

# Who terminates TLS:
#   builtin   This host, with Let's Encrypt. Forward 80/tcp, 443/tcp and 3478/udp here.
#   external  An existing reverse proxy that forwards plain HTTP to port 80 of this host.
#             Forward 3478/udp here.
EDGE_PROXY="builtin"

# builtin only: contact address for Let's Encrypt.
ACME_EMAIL="admin@example.com"

# external only: IPv4 of the reverse proxy as seen from this host. It is the only
# source allowed on port 80 and the only one trusted for X-Forwarded-For.
EXTERNAL_PROXY_IP=""

# Ban SSH brute-force sources. sshd_config is never modified.
ENABLE_FAIL2BAN="true"
# Space-separated IPv4 addresses or CIDRs that are never banned (admin network, VPN).
FAIL2BAN_IGNORE_IPS=""

# Optional overrides.
# INSTALL_DIR="/opt/netbird"
# NETBIRD_SERVER_IMAGE="netbirdio/netbird-server:0.81.3"
# DASHBOARD_IMAGE="netbirdio/dashboard:v2.95.0-rootless"
# TRAEFIK_IMAGE="traefik:v3.7.15"
# NETBIRD_SUBNET="172.30.0.0/24"
# TRAEFIK_IP="172.30.0.10"
